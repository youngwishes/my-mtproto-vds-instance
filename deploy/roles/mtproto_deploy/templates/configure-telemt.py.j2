#!/usr/bin/env python3
from __future__ import annotations

import os
import re
import stat
import sys
import tempfile
from pathlib import Path


GENERAL_TARGET_LINES = (
    'beobachten_file = {{ telemt_beobachten_path | to_json }}',
)
GENERAL_LINKS_TARGET_LINES = ('show = "*"',)
SERVER_API_TARGET_LINES = (
    'listen = {{ telemt_api_listen | to_json }}',
    'whitelist = {{ telemt_api_whitelist | to_json }}',
)
CENSORSHIP_TARGET_LINES = (
    'tls_domain = {{ telemt_tls_domain | to_json }}',
    'unknown_sni_action = "mask"',
    'mask = true',
    'mask_port = 443',
    'tls_emulation = false',
)
KEY_PATTERN = re.compile(r"^\s*([A-Za-z0-9_]+)\s*=")


def configure_section(
    lines: list[str],
    section: str,
    target_lines: tuple[str, ...],
) -> list[str]:
    try:
        section_start = next(
            index
            for index, line in enumerate(lines)
            if line.strip() == f"[{section}]"
        )
    except StopIteration:
        separator = [] if not lines or lines[-1].endswith("\n") else ["\n"]
        return lines + separator + [f"\n[{section}]\n"] + [
            f"{line}\n" for line in target_lines
        ]

    section_end = next(
        (
            index
            for index in range(section_start + 1, len(lines))
            if lines[index].lstrip().startswith("[")
        ),
        len(lines),
    )
    target_keys = {line.split("=", 1)[0].strip() for line in target_lines}
    retained = []
    for line in lines[section_start + 1 : section_end]:
        match = KEY_PATTERN.match(line)
        if match is None or match.group(1) not in target_keys:
            retained.append(line)

    replacement = [f"{line}\n" for line in target_lines]
    return (
        lines[: section_start + 1]
        + replacement
        + retained
        + lines[section_end:]
    )


def configure(config_path: Path, *, check: bool = False) -> bool:
    original = config_path.read_text()
    updated_lines = original.splitlines(keepends=True)
    updated_lines = configure_section(updated_lines, "general", GENERAL_TARGET_LINES)
    updated_lines = configure_section(
        updated_lines, "general.links", GENERAL_LINKS_TARGET_LINES
    )
    updated_lines = configure_section(
        updated_lines,
        "server.api",
        SERVER_API_TARGET_LINES,
    )
    updated_lines = configure_section(
        updated_lines,
        "censorship",
        CENSORSHIP_TARGET_LINES,
    )
    updated = "".join(updated_lines)
    if updated == original:
        return False
    if check:
        return True

    metadata = config_path.stat()
    descriptor, temporary_name = tempfile.mkstemp(
        dir=config_path.parent,
        prefix=f".{config_path.name}.",
    )
    try:
        with os.fdopen(descriptor, "w") as temporary:
            temporary.write(updated)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.chmod(temporary_name, stat.S_IMODE(metadata.st_mode))
        os.chown(temporary_name, metadata.st_uid, metadata.st_gid)
        os.replace(temporary_name, config_path)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)
    return True


if __name__ == "__main__":
    check_only = len(sys.argv) == 3 and sys.argv[1] == "--check"
    if len(sys.argv) != 2 and not check_only:
        raise SystemExit(f"usage: {sys.argv[0]} [--check] CONFIG_PATH")
    config_name = sys.argv[2] if check_only else sys.argv[1]
    print(
        "changed"
        if configure(Path(config_name), check=check_only)
        else "unchanged"
    )
